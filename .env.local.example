# ─────────────────────────────────────────────────────────────────────────────
# PHASE 1 — Google Maps (required now)
# ─────────────────────────────────────────────────────────────────────────────
# Create a key at: https://console.cloud.google.com/apis/credentials
# Enable these APIs on the key:
#   • Maps JavaScript API
#   • Places API  (or Places API (New))
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 2 — Google OAuth + Drive (needed in Phase 2)
# ─────────────────────────────────────────────────────────────────────────────
# OAuth Client ID/Secret from Google Cloud Console (type: Web Application)
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth — generate a random secret with: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Google Drive folder IDs (one per building type)
GOOGLE_DRIVE_FOLDER_SINGLE_FAMILY=
GOOGLE_DRIVE_FOLDER_MULTI_FAMILY=
GOOGLE_DRIVE_FOLDER_COMMERCIAL=
GOOGLE_DRIVE_FOLDER_MIXED_USE=

# ─────────────────────────────────────────────────────────────────────────────
# PHASE 3 & 4 — Gemini API (needed in Phases 3 & 4)
# ─────────────────────────────────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
